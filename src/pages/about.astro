---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AboutHero from '../components/AboutHero.astro';
import LifelineSection from '../components/LifelineSection.astro';
---

<Layout title="Über Konsti — Konstantin Patsalides" description="Wer steckt hinter Konsti? Der Werdegang von Konstantin Patsalides.">
	<main id="main" class="page-about__main">
		<AboutHero />
		<LifelineSection />
	</main>
	<Footer />
</Layout>

<script>
	import { initAboutCv } from '../scripts/about-cv-scroll.ts';

	const run = () => initAboutCv();

	run();
	document.addEventListener('astro:page-load', run);
</script>
