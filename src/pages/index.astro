---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import StatementSection from '../components/StatementSection.astro';
import FocusSection from '../components/FocusSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import StepsSection from '../components/StepsSection.astro';
import CtaSection from '../components/CtaSection.astro';
import LinkedinFeed from '../components/LinkedinFeed.astro';
import { withBase } from '../lib/base';

const portraitSrc = withBase('/teaser_bild_17386_80.jpg.png');
---

<Layout
	title="Konstantin Patsalides"
	description="Konstantin Patsalides — Berlin, Stadtentwicklung, Nachhaltigkeit, Technologie, Sport und Fashion."
	preloader
>
	<main id="main" class="page-home__main">
		<section class="intro page-home" aria-labelledby="intro-heading">
			<h1 id="intro-heading" class="intro__title hero-title">
				<span class="hero-title__label-slot hero-title__label-slot--first">
					<span class="hero-title__label hero-title__label--first">Konstantin</span>
				</span>
				<span class="hero-title__slot">
					<span class="hero-title__portrait-frame">
						<span class="hero-title__portrait-zoom">
							<img
								class="hero-title__portrait"
								src={portraitSrc}
								alt="Porträt von Konstantin Patsalides"
								width="2400"
								height="600"
								loading="eager"
								decoding="async"
								fetchpriority="high"
							/>
						</span>
					</span>
				</span>
				<span class="hero-title__label-slot hero-title__label-slot--last">
					<span class="hero-title__label hero-title__label--last">Patsalides</span>
				</span>
				<span class="hero-title__caption">
					<img
						class="hero-title__caption-logo"
						src={withBase('/KONSTANTINPATSALIDES.svg')}
						alt="Konstantin Patsalides"
						width="1602"
						height="186"
						loading="eager"
						decoding="async"
					/>
				</span>
			</h1>
		</section>
		<StatementSection />
		<FocusSection />
		<ProjectsSection />
		<StepsSection />
		<LinkedinFeed />
		<CtaSection />
	</main>
	<Footer />
</Layout>

<script>
	import { initScrollTextReveal } from '../scripts/scroll-text-reveal.ts';
	import { initProjectsScroll } from '../scripts/projects-scroll.ts';
	import { initStepsScroll } from '../scripts/steps-scroll.ts';

	const run = () => {
		initScrollTextReveal();
		initProjectsScroll();
		initStepsScroll();
	};

	run();
	document.addEventListener('astro:page-load', run);
</script>
