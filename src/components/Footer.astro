---
const year = new Date().getFullYear();

const legalLinks = [
	{ label: 'Impressum', href: '#' },
	{ label: 'Datenschutz', href: '#' },
] as const;

const socialLinks = [
	{
		label: 'Instagram',
		href: '#',
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.75"/><circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.75"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>`,
	},
	{
		label: 'YouTube',
		href: '#',
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 8.2s-.2-1.6-.8-2.3c-.8-.8-1.6-.8-2-0.9C16.8 4.8 12 4.8 12 4.8s-4.8 0-7.2.2c-.4 0-1.2.1-2 .9-.6.7-.8 2.3-.8 2.3S2 10.1 2 12s.2 3.8.2 3.8.2 1.6.8 2.3c.8.8 1.8.8 2.2.9 1.6.2 6.8.2 6.8.2s4.8 0 7.2-.2c.4 0 1.2-.1 2-.9.6-.7.8-2.3.8-2.3s.2-1.7.2-3.8-.2-3.8-.2-3.8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 15.5V8.5l6 3.5-6 3.5z" fill="currentColor"/></svg>`,
	},
	{
		label: 'X',
		href: '#',
		icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4l7.2 9.6L4.5 20H7l4.8-6.3L15.8 20H20l-7.6-10.1L19.1 4h-2.5l-4.4 5.8L8.7 4H4z" fill="currentColor"/></svg>`,
	},
] as const;

const bottomNav = [
	{ label: 'Fokus', href: '#focus-heading' },
	{ label: 'Projekte', href: '#projects-heading' },
	{ label: 'Ansatz', href: '#steps-heading' },
	{ label: 'Netzwerk', href: '#network-cta-heading' },
] as const;
---

<footer class="site-footer">
	<div class="site-footer__frame">
		<div class="site-footer__top">
			<nav class="site-footer__legal" aria-label="Rechtliches">
				<ul>
					{
						legalLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="site-footer__social" aria-label="Social Media">
				<ul>
					{
						socialLinks.map((link) => (
							<li>
								<a href={link.href} aria-label={link.label}>
									<span set:html={link.icon} />
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="site-footer__actions">
				<a class="site-footer__signin" href="/about">Über mich</a>
				<a class="site-footer__cta" href="mailto:kontakt@konstantinpatsalides.de">Kontakt</a>
			</div>
		</div>

		<div class="site-footer__logo">
			<img
				src="/KONSTANTINPATSALIDES.svg"
				alt="Konstantin Patsalides"
				width="1602"
				height="186"
				loading="lazy"
				decoding="async"
			/>
		</div>

		<div class="site-footer__bottom">
			<p class="site-footer__tagline">Berlin, Deutschland</p>

			<nav class="site-footer__nav" aria-label="Seitennavigation">
				<ul>
					{
						bottomNav.map((link, index) => (
							<li>
								{index > 0 ? <span class="site-footer__nav-sep" aria-hidden="true">•</span> : null}
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<a class="site-footer__credits" href="#">by DEVDESIGN</a>
		</div>
	</div>

	<p class="site-footer__copy">© {year} Konstantin Patsalides</p>
</footer>
