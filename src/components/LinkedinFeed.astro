<script>
	function syncViewportHeight(root: HTMLElement, index: number) {
		const viewport = root.querySelector<HTMLElement>('.li-feed__viewport');
		const slides = root.querySelectorAll<HTMLElement>('.li-feed__slide');
		const slide = slides[index];
		if (!viewport || !slide) return;

		viewport.style.height = 'auto';
		const height = slide.getBoundingClientRect().height;
		viewport.style.height = `${Math.ceil(height)}px`;
	}

	function scheduleViewportSync(root: HTMLElement, index: number) {
		requestAnimationFrame(() => {
			syncViewportHeight(root, index);
			requestAnimationFrame(() => syncViewportHeight(root, index));
		});
	}

	function initCarousel(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('.li-feed__track');
		const slides = root.querySelectorAll<HTMLElement>('.li-feed__slide');
		const dots = root.querySelectorAll<HTMLButtonElement>('.li-feed__dot');
		const prev = root.querySelector<HTMLButtonElement>('.li-feed__arrow--prev');
		const next = root.querySelector<HTMLButtonElement>('.li-feed__arrow--next');

		if (!track || slides.length === 0 || dots.length === 0) return;

		const total = slides.length;
		let index = 0;

		const update = () => {
			track.style.transform = `translateX(-${index * 100}%)`;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
			if (prev) prev.disabled = index === 0;
			if (next) next.disabled = index >= total - 1;
			scheduleViewportSync(root, index);
		};

		const go = (n: number) => {
			index = n;
			update();
		};

		prev?.addEventListener('click', () => {
			if (index > 0) go(index - 1);
		});
		next?.addEventListener('click', () => {
			if (index < total - 1) go(index + 1);
		});
		dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

		let startX = 0;
		track.addEventListener(
			'touchstart',
			(e) => { startX = e.touches[0].clientX; },
			{ passive: true },
		);
		track.addEventListener(
			'touchend',
			(e) => {
				const diff = startX - e.changedTouches[0].clientX;
				if (Math.abs(diff) > 50) {
					if (diff > 0 && index < total - 1) go(index + 1);
					else if (diff < 0 && index > 0) go(index - 1);
				}
			},
			{ passive: true },
		);

		slides.forEach((slide, slideIndex) => {
			const resizeObserver = new ResizeObserver(() => {
				if (slideIndex === index && slide.classList.contains('is-active')) {
					scheduleViewportSync(root, index);
				}
			});
			resizeObserver.observe(slide);

			slide.querySelectorAll('details').forEach((details) => {
				details.addEventListener('toggle', () => {
					if (slide.classList.contains('is-active')) {
						scheduleViewportSync(root, index);
					}
				});
			});
		});

		update();
		window.addEventListener('resize', () => scheduleViewportSync(root, index), { passive: true });
	}

	function initLinkedinFeedCarousel() {
		document.querySelectorAll<HTMLElement>('.li-feed-widget').forEach((root) => {
			if (root.dataset.carouselInit === 'true') return;

			const observer = new IntersectionObserver(
				([entry]) => {
					if (!entry.isIntersecting) return;
					observer.disconnect();
					root.dataset.carouselInit = 'true';
					initCarousel(root);
				},
				{ rootMargin: '200px' },
			);

			observer.observe(root);
		});
	}

	const run = () => initLinkedinFeedCarousel();
	run();
	document.addEventListener('astro:page-load', run);

</script>
