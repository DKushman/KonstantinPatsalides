---
const eyebrow = 'Über Konsti';
const title = 'Wer steckt hinter Konsti?';
---

<section id="about-hero" class="about-hero" aria-labelledby="about-hero-heading">
	<div class="about-hero__inner">
		<div class="about-hero__reveal about-hero__reveal--eyebrow">
			<p class="about-hero__eyebrow">{eyebrow}</p>
		</div>
		<div class="about-hero__reveal">
			<h1 id="about-hero-heading" class="about-hero__title">{title}</h1>
		</div>
	</div>
</section>
