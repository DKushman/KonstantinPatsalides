---
import participants from '../data/netzwerk.json';

type Participant = {
	name: string;
	company: string;
	linkedin: string;
	quote: string;
	slug: string;
};

const people = participants as Participant[];

const CLOUD = 'https://res.cloudinary.com/dqcdbdt4v/image/upload';

const img = (slug: string, w: number) =>
	`${CLOUD}/f_auto,q_auto,c_fill,g_auto,w_${w},h_${w}/${slug}`;

const srcset = (slug: string) =>
	[300, 450, 600, 800]
		.map((w) => `${img(slug, w)} ${w}w`)
		.join(', ');

const sanitizeLinkedin = (url: string) => {
	if (!url) return '';
	const clean = url.trim();
	return /^https?:\/\//.test(clean) ? clean : '';
};
---

<section class="net" aria-labelledby="net-heading" data-net>
	<header class="net__intro">
		<p class="net__eyebrow">Netzwerk</p>
		<h1 id="net-heading" class="net__heading">Konstantin kennt alles und jeden</h1>
		<p class="net__sub">Die Menschen, die Berlin bewegen.</p>
	</header>

	<div class="net__bar">
		<div class="net__views" role="group" aria-label="Ansicht wählen">
			<button
				type="button"
				class="net__view is-active"
				data-net-view="grid"
				aria-pressed="true"
				aria-label="Rasteransicht"
				title="Raster"
			>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<rect x="2.5" y="2.5" width="6" height="6" rx="1.2" fill="currentColor" />
					<rect x="11.5" y="2.5" width="6" height="6" rx="1.2" fill="currentColor" />
					<rect x="2.5" y="11.5" width="6" height="6" rx="1.2" fill="currentColor" />
					<rect x="11.5" y="11.5" width="6" height="6" rx="1.2" fill="currentColor" />
				</svg>
			</button>
			<button
				type="button"
				class="net__view"
				data-net-view="list"
				aria-pressed="false"
				aria-label="Listenansicht"
				title="Liste"
			>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<rect x="2.5" y="3.25" width="3" height="3" rx="0.8" fill="currentColor" />
					<rect x="7.5" y="4" width="10" height="1.5" rx="0.75" fill="currentColor" />
					<rect x="2.5" y="8.5" width="3" height="3" rx="0.8" fill="currentColor" />
					<rect x="7.5" y="9.25" width="10" height="1.5" rx="0.75" fill="currentColor" />
					<rect x="2.5" y="13.75" width="3" height="3" rx="0.8" fill="currentColor" />
					<rect x="7.5" y="14.5" width="10" height="1.5" rx="0.75" fill="currentColor" />
				</svg>
			</button>
		</div>

		<p class="net__count">{people.length} Mitglieder</p>
	</div>

	<ul class="net__grid" data-net-grid data-view="grid" role="list">
		{
			people.map((person, index) => {
				const linkedin = sanitizeLinkedin(person.linkedin);
				const hasQuote = person.quote.trim().length > 0;
				return (
					<li class="net-card" role="listitem">
						<div class="net-card__media">
							<img
								src={img(person.slug, 600)}
								srcset={srcset(person.slug)}
								sizes="(max-width: 48rem) 44vw, (max-width: 64rem) 30vw, 22vw"
								alt={`Porträt von ${person.name}`}
								width="600"
								height="600"
								loading={index < 8 ? 'eager' : 'lazy'}
								decoding="async"
								fetchpriority={index < 4 ? 'high' : 'auto'}
							/>
							{hasQuote && (
								<div class="net-card__quote" hidden>
									<p>{person.quote}</p>
								</div>
							)}
						</div>

						<div class="net-card__body">
							<div class="net-card__text">
								<h2 class="net-card__name">{person.name}</h2>
								{person.company && (
									<p class="net-card__company">{person.company}</p>
								)}
							</div>

							<div class="net-card__actions">
								{hasQuote && (
									<button
										type="button"
										class="net-card__more"
										aria-expanded="false"
										aria-label={`Mehr über ${person.name}`}
									>
										<span class="net-card__more-icon" aria-hidden="true" />
									</button>
								)}
								{linkedin && (
									<a
										class="net-card__li"
										href={linkedin}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${person.name} auf LinkedIn`}
									>
										<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
											/>
										</svg>
									</a>
								)}
							</div>
						</div>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.net {
		width: 100%;
	}

	.net__intro {
		text-align: center;
		max-width: 60rem;
		margin: 0 auto clamp(2rem, 5vw, 3.5rem);
	}

	.net__eyebrow {
		margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
		font-size: clamp(0.7rem, 1.4vw, 0.8rem);
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.net__heading {
		margin: 0;
		font-size: clamp(2rem, 5.5vw, 4.25rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.net__sub {
		margin: clamp(0.75rem, 2vw, 1.25rem) 0 0;
		font-size: clamp(1rem, 1.8vw, 1.3rem);
		color: var(--color-muted);
	}

	.net__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
	}

	.net__views {
		display: inline-flex;
		gap: 0.4rem;
		padding: 0.3rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	.net__view {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		transition:
			background-color 0.25s var(--ease-out-expo),
			color 0.25s var(--ease-out-expo);
	}

	.net__view:hover {
		color: var(--color-text);
	}

	.net__view:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.net__view.is-active {
		background: var(--color-accent);
		color: #fff;
	}

	.net__count {
		margin: 0;
		font-size: clamp(0.75rem, 1.4vw, 0.85rem);
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--color-muted);
	}

	/* ── Grid view ───────────────────────────────────────────────── */
	.net__grid {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.net__grid[data-view='grid'] {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: start;
		gap: clamp(1.25rem, 2.5vw, 2.25rem);
	}

	/* Staggered / offset wave across the four columns */
	.net__grid[data-view='grid'] .net-card:nth-child(4n + 1) {
		transform: translateY(clamp(0.75rem, 2vw, 2rem));
	}
	.net__grid[data-view='grid'] .net-card:nth-child(4n + 3) {
		transform: translateY(clamp(1.5rem, 4vw, 3.5rem));
	}
	.net__grid[data-view='grid'] .net-card:nth-child(4n + 4) {
		transform: translateY(clamp(0.4rem, 1vw, 1rem));
	}

	.net-card {
		min-width: 0;
	}

	.net-card__media {
		position: relative;
		overflow: hidden;
		border-radius: clamp(0.6rem, 1vw, 1.1rem);
		background: var(--color-surface);
		aspect-ratio: 1 / 1;
	}

	.net-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: translateZ(0);
		transition: transform 0.6s var(--ease-out-expo);
	}

	@media (hover: hover) {
		.net-card:hover .net-card__media img {
			transform: scale(1.04);
		}
	}

	.net-card__quote {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		padding: clamp(0.9rem, 2vw, 1.4rem);
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.92) 0%,
			rgba(0, 0, 0, 0.78) 55%,
			rgba(0, 0, 0, 0.55) 100%
		);
		color: #fff;
		overflow-y: auto;
		opacity: 0;
		transition: opacity 0.3s var(--ease-out-expo);
	}

	.net-card__quote[hidden] {
		display: flex;
	}

	.net-card.is-open .net-card__quote {
		opacity: 1;
	}

	.net-card__quote p {
		margin: 0;
		font-size: clamp(0.8rem, 1.2vw, 0.95rem);
		line-height: 1.45;
	}

	.net-card__body {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: clamp(0.7rem, 1.4vw, 1rem);
	}

	.net-card__text {
		min-width: 0;
	}

	.net-card__name {
		margin: 0;
		font-size: clamp(0.95rem, 1.5vw, 1.15rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.net-card__company {
		margin: 0.2rem 0 0;
		font-size: clamp(0.78rem, 1.2vw, 0.9rem);
		line-height: 1.3;
		color: var(--color-muted);
	}

	.net-card__actions {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.net-card__more,
	.net-card__li {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		text-decoration: none;
		transition:
			background-color 0.25s var(--ease-out-expo),
			color 0.25s var(--ease-out-expo),
			border-color 0.25s var(--ease-out-expo),
			transform 0.25s var(--ease-out-expo);
	}

	.net-card__more:hover,
	.net-card__li:hover {
		border-color: var(--color-text);
		transform: translateY(-1px);
	}

	.net-card__li:hover {
		background: var(--color-accent);
		color: #fff;
	}

	.net-card__more:focus-visible,
	.net-card__li:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.net__grid[data-view='grid'] .net-card__actions {
		gap: clamp(0.2rem, 0.8vw, 0.35rem);
	}

	.net__grid[data-view='grid'] .net-card__more,
	.net__grid[data-view='grid'] .net-card__li {
		width: clamp(1.35rem, 3.2vw, 1.75rem);
		height: clamp(1.35rem, 3.2vw, 1.75rem);
	}

	.net__grid[data-view='grid'] .net-card__li svg {
		width: clamp(0.7rem, 1.8vw, 0.875rem);
		height: clamp(0.7rem, 1.8vw, 0.875rem);
	}

	.net-card__more-icon {
		position: relative;
		width: 0.8rem;
		height: 0.8rem;
	}

	.net__grid[data-view='grid'] .net-card__more-icon {
		width: clamp(0.5rem, 1.2vw, 0.65rem);
		height: clamp(0.5rem, 1.2vw, 0.65rem);
	}

	.net-card__more-icon::before,
	.net-card__more-icon::after {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		background: currentColor;
		transition: transform 0.3s var(--ease-out-expo);
	}

	.net-card__more-icon::before {
		width: 100%;
		height: 1.5px;
	}

	.net-card__more-icon::after {
		width: 1.5px;
		height: 100%;
	}

	.net-card.is-open .net-card__more {
		background: var(--color-accent);
		color: #fff;
		border-color: var(--color-accent);
	}

	.net-card.is-open .net-card__more-icon::after {
		transform: rotate(90deg);
		opacity: 0;
	}

	/* ── List view ───────────────────────────────────────────────── */
	.net__grid[data-view='list'] {
		display: flex;
		flex-direction: column;
		gap: 0;
		max-width: 52rem;
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.net__grid[data-view='list'] .net-card {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2vw, 1.1rem);
		padding: clamp(0.6rem, 1.6vw, 0.85rem) 0;
		border-bottom: 1px solid var(--color-border);
		transform: none;
	}

	.net__grid[data-view='list'] .net-card__media {
		flex-shrink: 0;
		width: clamp(2.75rem, 6vw, 3.25rem);
		height: clamp(2.75rem, 6vw, 3.25rem);
		border-radius: 999px;
		aspect-ratio: 1 / 1;
	}

	.net__grid[data-view='list'] .net-card__quote {
		display: none;
	}

	.net__grid[data-view='list'] .net-card__body {
		flex: 1;
		align-items: center;
		margin-top: 0;
	}

	.net__grid[data-view='list'] .net-card__more {
		display: none;
	}

	.net__grid[data-view='list'] .net-card__name {
		font-size: clamp(0.9rem, 1.4vw, 1.05rem);
	}

	/* ── Responsive ──────────────────────────────────────────────── */
	@media (max-width: 64rem) {
		.net__grid[data-view='grid'] {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.net__grid[data-view='grid'] .net-card:nth-child(4n + 1),
		.net__grid[data-view='grid'] .net-card:nth-child(4n + 3),
		.net__grid[data-view='grid'] .net-card:nth-child(4n + 4) {
			transform: none;
		}
		.net__grid[data-view='grid'] .net-card:nth-child(3n + 2) {
			transform: translateY(clamp(1rem, 3vw, 2.5rem));
		}
	}

	@media (max-width: 40rem) {
		.net__grid[data-view='grid'] {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(1rem, 4vw, 1.5rem);
		}
		.net__grid[data-view='grid'] .net-card:nth-child(3n + 2) {
			transform: none;
		}
		.net__grid[data-view='grid'] .net-card:nth-child(2n) {
			transform: translateY(clamp(0.75rem, 4vw, 1.75rem));
		}
		.net-card__actions {
			gap: 0.3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.net-card,
		.net-card__media img,
		.net-card__quote,
		.net-card__more-icon::before,
		.net-card__more-icon::after {
			transition: none;
		}
		.net__grid[data-view='grid'] .net-card {
			transform: none !important;
		}
	}
</style>

<script>
	import { initNetzwerkView } from '../scripts/netzwerk-view.ts';

	const run = () => initNetzwerkView();
	run();
	document.addEventListener('astro:page-load', run);
</script>
